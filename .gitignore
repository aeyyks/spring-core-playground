# ==========================================
# Локальные настройки и секреты (Важно!)
# ==========================================
# Игнорируем файлы, где могут храниться пароли, токены и приватные ключи
*.properties
*.yml
*.yaml

# Исключение: разрешаем коммитить дефолтные файлы конфигурации,
# если вы используете подход с application-local.properties для разработки.
!**/src/main/resources/application.properties
!**/src/main/resources/application.yml
!**/src/main/resources/application.yaml

# Локальные профили и секреты
application-local.*
application-dev.*
.env
.env.*

